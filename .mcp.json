{
  "mcpServers": {
    "parasiter": {
      "type": "http",
      "url": "https://parasiter.affiliatecredo.com/mcp",
      "headers": {
        "Authorization": "Bearer ${user_config.parasiter_key}"
      }
    },
    "parasiter-dataforseo": {
      "type": "stdio",
      "command": "python3",
      "args": [
        "${CLAUDE_PLUGIN_ROOT}/mcp/dataforseo_server.py"
      ],
      "env": {
        "PARASITER_DFS_LOGIN": "${user_config.dataforseo_login}",
        "PARASITER_DFS_PASSWORD": "${user_config.dataforseo_password}"
      }
    },
    "parasiter-serpapi": {
      "type": "stdio",
      "command": "python3",
      "args": [
        "${CLAUDE_PLUGIN_ROOT}/mcp/serpapi_server.py"
      ],
      "env": {
        "PARASITER_SERPAPI_KEY": "${user_config.serpapi_key}"
      }
    }
  }
}
